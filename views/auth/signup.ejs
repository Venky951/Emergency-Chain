<%- include ('../partials/head', { title: 'Signup - Emergency Chain' }) %>

</head>

<body class="min-h-screen flex items-center justify-center px-4 py-8 text-white">

  <!-- Background Glow -->
  <div class="absolute w-96 h-96 bg-red-500/20 blur-3xl rounded-full top-10 left-10"></div>
  <div class="absolute w-96 h-96 bg-orange-500/10 blur-3xl rounded-full bottom-10 right-10"></div>

  <!-- Signup Card -->
  <div class="glass relative z-10 w-full max-w-2xl rounded-3xl p-8 shadow-2xl">

    <!-- Logo -->
    <div class="text-center mb-8">

      <h1 class="text-4xl font-bold gradient-text mb-2">
        EmergencyChain
      </h1>

      <p class="text-slate-400">
        Create your emergency response account
      </p>

    </div>

    <!-- Signup Form -->
    <!-- Error Message -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div role="alert" class="bg-red-500/20 border border-red-500 text-red-200 px-4 py-3 rounded-xl mb-6 text-sm">
        <%= errorMessage %>
      </div>
    <% } %>

    <!-- Signup Form -->
<form action="/signup" method="POST" class="space-y-6">

  <!-- Name + Phone -->
  <div class="grid md:grid-cols-2 gap-6">

    <div>

      <label for="signup-name" class="block mb-2 text-slate-200 font-medium">
        Full Name
      </label>

      <input
        id="signup-name"
        type="text"
        name="name"
        autocomplete="name"
        placeholder="Enter your full name"
        value="<%= typeof oldInput !== 'undefined' && oldInput.name ? oldInput.name : '' %>"
        class="form-control"
        required
      />

    </div>

    <div>

      <label for="signup-phone" class="block mb-2 text-slate-200 font-medium">
        Phone Number
      </label>

      <input
        id="signup-phone"
        type="tel"
        name="phone"
        autocomplete="tel"
        placeholder="Enter phone number"
        value="<%= typeof oldInput !== 'undefined' && oldInput.phone ? oldInput.phone : '' %>"
        class="form-control"
        required
      />

    </div>

  </div>

  <!-- Email -->
  <div>

    <label for="signup-email" class="block mb-2 text-slate-200 font-medium">
      Email Address
    </label>

    <input
      id="signup-email"
      type="email"
      name="email"
      autocomplete="email"
      placeholder="Enter your email"
      value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
      class="form-control"
      required
    />

  </div>

  <!-- Password + Confirm -->
  <div class="grid md:grid-cols-2 gap-6">

    <div>

      <label for="signup-password" class="block mb-2 text-slate-200 font-medium">
        Password
      </label>

      <input
        id="signup-password"
        type="password"
        name="password"
        autocomplete="new-password"
        placeholder="Create password"
        class="form-control"
        required
      />

    </div>

    <div>

      <label for="signup-confirm-password" class="block mb-2 text-slate-200 font-medium">
        Confirm Password
      </label>

      <input
        id="signup-confirm-password"
        type="password"
        name="confirmPassword"
        autocomplete="new-password"
        placeholder="Confirm password"
        class="form-control"
        required
      />

    </div>

  </div>

  <!-- Emergency Contact -->
  <div>

    <label for="signup-emergency-contact" class="block mb-2 text-slate-200 font-medium">
      Emergency Contact Number
    </label>

    <input
      id="signup-emergency-contact"
      type="tel"
      name="emergencyContact"
      autocomplete="tel"
      placeholder="Emergency contact number"
      value="<%= typeof oldInput !== 'undefined' && oldInput.emergencyContact ? oldInput.emergencyContact : '' %>"
      class="form-control"
      required
    />

  </div>

  <input type="hidden" name="role" value="citizen" />

  <!-- Terms -->
  <label for="signup-terms" class="flex items-start gap-3 text-slate-300 text-sm">

    <input id="signup-terms" type="checkbox" name="termsAgreed" required class="mt-1" />

    I agree to share emergency-related data for safety purposes.

  </label>

  <!-- Signup Button -->
  <button
    type="submit"
    class="btn-primary w-full py-3 rounded-xl font-semibold shadow-lg shadow-red-500/20 transition-colors"
  >
    Create Account
  </button>

</form>
</div>
