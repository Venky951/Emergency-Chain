<%- include('partials/head', { title: 'EmergencyChain - Intelligent Emergency Response System' }) %>

<body class="bg-slate-950 text-white min-h-screen">

<%- include('partials/nav') %>

<main class="px-6 md:px-16 py-10">
  <section class="glass rounded-3xl p-6 md:p-8 max-w-6xl mx-auto">
    <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
      <div>
        <h1 class="text-4xl md:text-5xl font-bold mb-2">Emergency Map</h1>
        <p class="text-slate-400">
          Map stays visible on the landing page. Login is required before location tracking or nearby helper lookup.
        </p>
      </div>

    </div>

    <div id="map" class="w-full h-[70vh] rounded-2xl overflow-hidden border border-slate-700 bg-slate-900"></div>

    <p class="text-sm text-slate-500 mt-4">
      No geolocation request before login. The map shows a default view until the authenticated dashboard takes over.
    </p>
  </section>
</main>

<script src="/app.js"></script>

<script>
let landingMap;

function initializeLandingMap() {
  if (landingMap) {
    return;
  }

  const indiaCenter = [20.5937, 78.9629];

  landingMap = L.map("map", {
    center: indiaCenter,
    zoom: 5,
    zoomControl: true,
  });

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 19,
  }).addTo(landingMap);

}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initializeLandingMap);
} else {
  initializeLandingMap();
}
</script>

</body>
</html>