<%- include('partials/head', { title: 'Emergency SOS - EmergencyChain' }) %>

<body class="bg-slate-950 text-white min-h-screen">
<%- include('partials/nav') %>

<main class="px-4 sm:px-6 md:px-16 py-6 sm:py-10 max-w-5xl mx-auto">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="page-title mb-2">Emergency SOS</h1>
      <p class="body-copy">Send a request and follow its progress here.</p>
    </div>
    <p id="connectionStatus" role="status" aria-live="polite" aria-atomic="true" class="helper-copy">Checking connection…</p>
  </div>

  <% if (userRole === 'citizen') { %>
    <%- include('partials/emergency-workflow', { userId, dashboard: false }) %>
  <% } else { %>
    <div class="glass p-5 sm:p-8">
      <h2 class="section-title mb-3">Responder account</h2>
      <p class="body-copy mb-4">Emergency requests are sent from citizen accounts. View emergencies seeking help in your dashboard.</p>
      <a href="/dashboard" class="btn-primary emergency-action inline-flex">Open dashboard</a>
    </div>
  <% } %>
</main>

<script src="/app.js?v=5.2"></script>
<script src="/emergency-workflow.js?v=5.2"></script>
<script>
let map;
let currentLat;
let currentLng;
let currentAccuracy;
let currentEmergencyId;
const socket = EC.initializeSocket();
const emergencyWorkflow = EC.createEmergencyWorkflow({
  socket,
  requestLocation: requestSosLocation,
  onEmergencyId(id) { currentEmergencyId = id; },
});
emergencyWorkflow?.initialize();

async function requestSosLocation() {
  if (!emergencyWorkflow) return;
  emergencyWorkflow.setLocationPending();
  try {
    const location = await EC.locationTracker.getCurrentLocation();
    currentLat = location.latitude;
    currentLng = location.longitude;
    currentAccuracy = location.accuracy;
    emergencyWorkflow.setLocation(location);
  } catch (error) {
    emergencyWorkflow.setLocationUnavailable(error);
    return;
  }

  try {
    const response = await fetch("/update-location", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ latitude: currentLat, longitude: currentLng }),
    });
    if (!response.ok) throw new Error("Account location update failed");
  } catch (error) {
    emergencyWorkflow.setLocationNote("Location captured. Your account location could not be updated; an SOS will still include these coordinates.");
  }
}

function updateConnectionStatus() {
  const connection = EC.getConnectionState();
  document.getElementById("connectionStatus").textContent = connection.network === "offline"
    ? "Offline"
    : connection.socket === "connected"
      ? "Online · Server connected"
      : connection.socket === "reconnecting"
        ? "Online · Reconnecting…"
        : "Online · Server disconnected";
}
window.addEventListener("online", updateConnectionStatus);
window.addEventListener("offline", updateConnectionStatus);
socket?.on("connect", updateConnectionStatus);
socket?.on("disconnect", updateConnectionStatus);
socket?.on("connect_error", updateConnectionStatus);
updateConnectionStatus();

if (document.readyState === "complete") {
  requestSosLocation();
} else {
  window.addEventListener("load", requestSosLocation, { once: true });
}
</script>
</body>
</html>
