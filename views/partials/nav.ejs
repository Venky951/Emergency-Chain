<!-- Navbar -->
<nav class="flex flex-wrap justify-between items-center gap-4 px-4 sm:px-8 py-4 sm:py-6">

    <!-- Logo Section -->
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold gradient-text">
        EmergencyChain
      </h1>

      <p class="text-slate-300 text-sm">
        Intelligent Emergency Response System
      </p>
    </div>

    <!-- Buttons Section -->
     <% if (!isLoggedIn) { %>
    <div class="flex flex-wrap gap-2 sm:gap-3">

      <a href="/login"
        class="btn-primary transition-colors px-4 sm:px-6 py-3 rounded-xl font-semibold shadow-lg shadow-red-500/20"
      >
        Login
      </a>

      <a href="/signup"
        class="btn-secondary transition-colors px-4 sm:px-6 py-3 rounded-xl font-semibold"
      >
        Sign Up
      </a>

    </div>
<% } %>
<% if (isLoggedIn) { %>
    <div class="flex flex-wrap gap-2 sm:gap-3">

      <a href="/dashboard"
        class="btn-primary transition-colors px-4 sm:px-6 py-3 rounded-xl font-semibold shadow-lg shadow-red-500/20"
      >
        Dashboard
      </a>

      <form action="/logout" method="POST" class="m-0">
        <button type="submit"
          class="btn-secondary transition-colors px-4 sm:px-6 py-3 rounded-xl font-semibold"
        >
          Logout
        </button>
      </form>
      </div>
      <% } %>
  </nav>
