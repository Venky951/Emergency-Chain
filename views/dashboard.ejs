<%- include('partials/head', { title: 'Dashboard - EmergencyChain' }) %>

<body class="bg-slate-950 text-white min-h-screen">

<%- include('partials/nav') %>

<!-- HEADER -->
<section class="px-6 md:px-16 py-6 border-b border-slate-800">
  <div class="flex justify-between items-center flex-wrap gap-4">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="text-slate-300">Welcome, <span id="userName" class="font-semibold text-red-300"><%= user.name %></span></p>
    </div>
    <div class="flex gap-2">
      <div id="connectionStatus" role="status" aria-live="polite" aria-atomic="true" class="flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800 text-slate-200 text-sm">
        Checking connection…
      </div>
    </div>
  </div>
</section>

<!-- SHARED CITIZEN EMERGENCY WORKFLOW -->
<% if (user.role === 'citizen') { %>
<section class="px-4 sm:px-6 md:px-16 py-6 sm:py-10">
  <%- include('partials/emergency-workflow', { userId, dashboard: true }) %>
</section>
<% } %>
<!-- MAP & STATUS -->
<section class="px-6 md:px-16 py-10">
  <div class="grid md:grid-cols-3 gap-6">

    <!-- MAP -->
    <div class="md:col-span-2 glass rounded-3xl p-8">
      <h2 class="section-title mb-4">📍 Your Location</h2>
      <div id="map" role="region" aria-label="Map showing your location, nearby helpers, and emergency alerts" class="w-full h-96 rounded-2xl overflow-hidden border border-slate-700 bg-slate-900"></div>
      <p class="text-sm text-slate-300 mt-4">
        <span id="locationStatus" role="status" aria-live="polite" aria-atomic="true">Requesting location permission…</span>
      </p>
    </div>

    <!-- STATUS CARDS -->
    <div class="space-y-6">

      <!-- YOUR PROFILE -->
      <div class="glass rounded-3xl p-8">
        <h3 class="card-title mb-4">Profile</h3>
        <div class="space-y-3 text-sm">
          <div>
            <p class="text-slate-300">Name</p>
            <p class="font-semibold"><%= user.name %></p>
          </div>
          <div>
            <p class="text-slate-300">Role</p>
            <p class="font-semibold capitalize"><%= user.role %></p>
          </div>
          <div>
            <p class="text-slate-300">Phone</p>
            <p class="font-semibold"><%= user.phone || 'Not set' %></p>
          </div>
          <div>
            <p class="text-slate-300">Status</p>
            <p class="font-semibold text-green-400">🟢 Active</p>
          </div>
        </div>
      </div>

      <!-- QUICK STATS -->
      <div class="glass rounded-3xl p-8">
        <h3 class="card-title mb-4">Stats</h3>
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-slate-300">Nearby Helpers</span>
            <span id="nearbyCount" class="font-bold text-xl">0</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-slate-300">Active Alerts</span>
            <span id="alertsCount" class="font-bold text-xl">0</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- NEARBY HELPERS -->
<section class="px-6 md:px-16 py-10">
  <div class="glass rounded-3xl p-8">
    <h2 class="section-title mb-6">👥 Nearby Helpers</h2>
    <div id="helpersList" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="bg-slate-800 rounded-xl p-4 text-slate-300">
        Loading helpers...
      </div>
    </div>
  </div>
</section>

<!-- NEARBY ALERTS -->
<section class="px-6 md:px-16 py-10">
  <div class="glass rounded-3xl p-8">
    <h2 class="section-title mb-6">🔔 Nearby Alerts</h2>
    <div id="alertsList" class="space-y-4">
      <div class="bg-slate-800 rounded-xl p-4 text-slate-300">
        Monitoring for nearby emergencies...
      </div>
    </div>
  </div>
</section>

<% if (["volunteer", "ambulance_driver", "hospital_staff"].includes(user.role)) { %>
<section class="px-6 md:px-16 py-10">
  <div class="glass rounded-3xl p-8">
    <h2 class="section-title mb-6">Emergencies Seeking Help</h2>
    <div id="searchingEmergenciesList" class="space-y-4">
      <div class="bg-slate-800 rounded-xl p-4 text-slate-300">
        Loading emergencies...
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- SCRIPTS -->
<script src="/app.js?v=5.2"></script>
<script src="/emergency-workflow.js?v=5.2"></script>

<script>
/**
 * Dashboard - Authenticated Emergency Response
 */

let map;
let userMarker;
let helpersLayerGroup;
let alertsLayerGroup;
let currentLat;
let currentLng;
const isResponder = <%= JSON.stringify(["volunteer", "ambulance_driver", "hospital_staff"].includes(user.role)) %>;
let currentEmergencyId;
let locationTrackingStarted = false;

// ========================================
// 1. MAP INITIALIZATION
// ========================================

async function initializeDashboardMap() {
  emergencyWorkflow?.setLocationPending();
  document.getElementById("locationStatus").textContent = "Requesting location permission…";
  try {
    const defaultCenter = [20.5937, 78.9629];

    if (!map) {
      map = L.map("map", {
        center: defaultCenter,
        zoom: 5,
        dragging: !L.Browser.mobile,
        tap: !L.Browser.mobile,
      });

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution:
          '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      helpersLayerGroup = L.layerGroup().addTo(map);
      alertsLayerGroup = L.layerGroup().addTo(map);
    }

    // Request exact location only inside the authenticated dashboard.
    const location = await EC.locationTracker.getCurrentLocation();
    currentLat = location.latitude;
    currentLng = location.longitude;
    emergencyWorkflow?.setLocation(location);
    document.getElementById("locationStatus").textContent = "Location captured — updates requested every 10 seconds.";

    if (userMarker) {
      userMarker.setLatLng([currentLat, currentLng]);
    } else {
      userMarker = L.marker([currentLat, currentLng])
        .addTo(map)
        .bindPopup("📍 Your Location");
    }
    map.setView([currentLat, currentLng], 15);

    console.log("[Dashboard] Map initialized");

    // Update user location on server
    try {
      const response = await fetch("/update-location", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ latitude: currentLat, longitude: currentLng }),
      });
      if (!response.ok) throw new Error("Account location update failed");
    } catch (error) {
      emergencyWorkflow?.setLocationNote("Location captured. Your account location could not be updated; an SOS will still include these coordinates.");
      document.getElementById("locationStatus").textContent = "Location captured — account update unavailable.";
    }

    return true;

  } catch (err) {
    console.warn("[Dashboard] Location unavailable:", err.message);
    emergencyWorkflow?.setLocationUnavailable(err);
    document.getElementById("locationStatus").textContent =
      "Location unavailable. Allow location access and retry to use SOS and nearby features.";
    return false;
  }
}

// ========================================
// 2. LOCATION TRACKING
// ========================================

async function startLocationTracking() {
  if (locationTrackingStarted) return;
  locationTrackingStarted = true;
  try {
    // Request notification permission
    await EC.requestNotificationPermission();

    // Start continuous tracking (10s interval)
    EC.locationTracker.startTracking(socket);

    // Update map every 10s
    setInterval(async () => {
      try {
        const location = await EC.locationTracker.getCurrentLocation();
        currentLat = location.latitude;
        currentLng = location.longitude;
        emergencyWorkflow?.setLocation(location);
        document.getElementById("locationStatus").textContent = "Location captured — updates requested every 10 seconds.";

        // Update marker
        if (userMarker) {
          userMarker.setLatLng([currentLat, currentLng]);
        }

        // Update nearby helpers and alerts
        await loadNearbyHelpers();
        await loadNearbyAlerts();
      } catch (err) {
        emergencyWorkflow?.setLocationUnavailable(err);
        document.getElementById("locationStatus").textContent = "Location update unavailable. Allow location access and retry.";
        console.error("[Dashboard] Location update error:", err);
      }
    }, 10000);

    console.log("[Dashboard] Location tracking started");
  } catch (err) {
    locationTrackingStarted = false;
    console.error("[Dashboard] Tracking error:", err);
  }
}

// ========================================
// 3. LOAD NEARBY HELPERS
// ========================================

async function loadNearbyHelpers() {
  try {
    const res = await fetch(
      `/nearby-users?latitude=${currentLat}&longitude=${currentLng}&radius=5`
    );

    if (!res.ok) {
      console.log("[Dashboard] Nearby users fetch failed:", res.status);
      return;
    }

    const payload = await res.json();
    const helpers = payload.users || [];
    document.getElementById("nearbyCount").textContent = helpers.length;

    // Clear existing markers
    helpersLayerGroup.clearLayers();

    // Update UI
    const helpersList = document.getElementById("helpersList");
    helpersList.replaceChildren();

    if (!helpers.length) {
      const emptyState = document.createElement("div");
      emptyState.className = "bg-slate-800 rounded-xl p-4 text-slate-300 col-span-full";
      emptyState.textContent = "No nearby helpers found";
      helpersList.appendChild(emptyState);
      return;
    }

    helpers.forEach((helper) => {
      const popup = document.createElement("div");
      const popupName = document.createElement("strong");
      popupName.textContent = helper.name || "Nearby helper";
      const popupRole = document.createElement("span");
      popupRole.textContent = ` ${helper.role || ""}`;
      popup.append(popupName, document.createElement("br"), popupRole);
      L.marker([helper.location.latitude, helper.location.longitude])
        .addTo(helpersLayerGroup)
        .bindPopup(popup);

      const card = document.createElement("div");
      card.className = "bg-slate-800 rounded-xl p-4 hover:bg-slate-700 transition";
      const header = document.createElement("div");
      header.className = "flex justify-between items-start mb-2";
      const details = document.createElement("div");
      const name = document.createElement("p");
      name.className = "font-bold";
      name.textContent = helper.name || "Nearby helper";
      const role = document.createElement("p");
      role.className = "text-sm text-slate-300 capitalize";
      role.textContent = helper.role || "";
      details.append(name, role);
      const distance = document.createElement("span");
      distance.className = "text-green-400 font-bold";
      distance.textContent = `${Number(helper.distance).toFixed(1)}km`;
      header.append(details, distance);
      const lastSeen = document.createElement("div");
      lastSeen.className = "text-sm text-slate-300";
      lastSeen.textContent = `📍 ${helper.lastSeen ? "Active now" : "Offline"}`;
      card.append(header, lastSeen);
      helpersList.appendChild(card);
    });
  } catch (err) {
    console.error("[Dashboard] Load helpers error:", err);
  }
}

// ========================================
// 4. LOAD NEARBY ALERTS
// ========================================

async function loadNearbyAlerts() {
  try {
    const res = await fetch(
      `/api/emergency/nearby-alerts?latitude=${currentLat}&longitude=${currentLng}`
    );

    if (!res.ok) {
      console.log("[Dashboard] Nearby alerts fetch failed:", res.status);
      return;
    }

    const alerts = await res.json();
    document.getElementById("alertsCount").textContent = alerts.length;

    // Clear existing markers
    alertsLayerGroup.clearLayers();

    // Update UI
    const alertsList = document.getElementById("alertsList");
    alertsList.replaceChildren();

    if (!alerts.length) {
      const emptyState = document.createElement("div");
      emptyState.className = "bg-slate-800 rounded-xl p-4 text-slate-300";
      emptyState.textContent = "No nearby alerts right now";
      alertsList.appendChild(emptyState);
      return;
    }

    alerts.forEach((alert) => {
      const popup = document.createElement("div");
      const popupTitle = document.createElement("strong");
      popupTitle.textContent = `Level ${alert.level} Alert`;
      const popupReason = document.createElement("span");
      popupReason.textContent = ` ${alert.reason || "Emergency alert"}`;
      popup.append(popupTitle, document.createElement("br"), popupReason);
      L.marker([alert.location.coordinates[1], alert.location.coordinates[0]])
        .addTo(alertsLayerGroup)
        .bindPopup(popup);

      // Add to list
      const levelEmoji = alert.level === 3 ? "🆘" : alert.level === 2 ? "🔔" : "⚠️";
      const alertTone = alert.level === 3
        ? "bg-red-900/30 border-red-500/50"
        : alert.level === 2
          ? "bg-orange-900/30 border-orange-500/50"
          : "bg-amber-900/30 border-amber-500/50";

      const card = document.createElement("div");
      card.className = `${alertTone} border rounded-xl p-4`;
      const header = document.createElement("div");
      header.className = "flex justify-between items-start mb-2";
      const details = document.createElement("div");
      const title = document.createElement("p");
      title.className = "font-bold";
      title.textContent = `${levelEmoji} Level ${alert.level} Alert`;
      const reason = document.createElement("p");
      reason.className = "text-sm text-slate-300";
      reason.textContent = alert.reason || "Emergency alert";
      details.append(title, reason);
      const helpButton = document.createElement("button");
      helpButton.className = "btn-success px-3 py-2 rounded-lg text-sm font-bold transition-colors";
      helpButton.textContent = "Help";
      helpButton.addEventListener("click", () => acceptAlert(alert._id));
      header.append(details, helpButton);
      const metadata = document.createElement("div");
      metadata.className = "text-sm text-slate-300";
      metadata.textContent = `👤 ${alert.userName || "Nearby user"} • ⏱️ ${alert.expiresAt ? "Active" : "Expired"}`;
      card.append(header, metadata);
      alertsList.appendChild(card);
    });
  } catch (err) {
    console.error("[Dashboard] Load alerts error:", err);
  }
}

async function loadSearchingEmergencies() {
  if (!isResponder) return;

  const list = document.getElementById("searchingEmergenciesList");
  try {
    const response = await fetch("/api/emergency/searching-for-help", {
      headers: { Accept: "application/json" },
    });
    const data = await response.json();

    if (!response.ok) {
      list.textContent = data.error || "Unable to load emergencies.";
      return;
    }

    list.replaceChildren();
    if (!data.emergencies.length) {
      list.textContent = "No emergencies are currently seeking help.";
      return;
    }

    data.emergencies.forEach((emergency) => {
      const card = document.createElement("div");
      card.className = "bg-slate-800 rounded-xl p-4 flex flex-wrap justify-between items-center gap-4";

      const summary = document.createElement("div");
      const title = document.createElement("p");
      title.className = "font-bold";
      title.textContent = emergency.emergencyType;
      const description = document.createElement("p");
      description.className = "text-sm text-slate-300";
      description.textContent = emergency.description || "Emergency request";
      const status = document.createElement("p");
      status.className = "text-sm text-slate-300";
      status.dataset.emergencyStatus = "true";
      status.textContent = `Status: ${emergency.status}`;
      summary.append(title, description, status);

      const button = document.createElement("button");
      button.className = "btn-success px-4 py-2 rounded-xl font-semibold transition-colors";
      button.textContent = "Accept";
      button.addEventListener("click", () =>
        acceptEmergency(emergency._id, button, status),
      );

      card.append(summary, button);
      list.appendChild(card);
    });
  } catch (error) {
    console.error("[Dashboard] Searching emergencies error:", error);
    list.textContent = "Unable to load emergencies.";
  }
}

async function acceptEmergency(emergencyId, button, statusElement) {
  try {
    const response = await fetch(`/api/emergency/${emergencyId}/accept`, {
      method: "POST",
      headers: { Accept: "application/json" },
    });
    const data = await response.json();

    if (!response.ok) {
      statusElement.textContent = data.error || "Unable to accept emergency.";
      return;
    }

    button.disabled = true;
    button.textContent = "Assigned";
    statusElement.textContent = `Status: ${data.emergency.status}`;
  } catch (error) {
    console.error("[Dashboard] Emergency acceptance error:", error);
    statusElement.textContent = "Unable to accept emergency.";
  }
}

// ========================================
// 6. ACCEPT ALERT
// ========================================

async function acceptAlert(alertId) {
  try {
    const res = await fetch("/api/emergency/accept", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ alertId }),
    });

    if (!res.ok) {
      alert("Error accepting alert: " + res.statusText);
      return;
    }

    alert("Alert accepted.");
    await loadNearbyAlerts();
  } catch (err) {
    console.error("[Dashboard] Accept error:", err);
  }
}

// ========================================
// 7. SOCKET.IO REAL-TIME UPDATES
// ========================================

const socket = EC.initializeSocket();
const emergencyWorkflow = EC.createEmergencyWorkflow({
  socket,
  requestLocation: requestDashboardLocation,
  onEmergencyId(id) { currentEmergencyId = id; },
});
emergencyWorkflow?.initialize();

if (socket) {
  if (isResponder) {
    EC.registerEmergencyUpdateListener(socket, loadSearchingEmergencies);
  }

  socket.on("sos-level-1", (data) => {
    console.log("[Socket] Level 1 SOS received");
    EC.showNotification("🚨 Emergency Alert", data.reason);
  });

  socket.on("sos-level-2", (data) => {
    console.log("[Socket] Level 2 SOS received");
    EC.showNotification("🔔 Help Needed Nearby", data.reason);
    loadNearbyAlerts();
  });

  socket.on("sos-level-3", (data) => {
    console.log("[Socket] Level 3 SOS received");
    EC.showNotification("🆘 CRITICAL EMERGENCY", data.userName + " needs immediate help!");
    loadNearbyAlerts();
  });

  socket.on("alert-accepted", (data) => {
    console.log("[Socket] Alert accepted:", data);
    loadNearbyAlerts();
  });
}

// ========================================
// 8. CONNECTION STATUS
// ========================================

function updateConnectionStatus() {
  const connection = EC.getConnectionState();
  document.getElementById("connectionStatus").textContent = connection.network === "offline"
    ? "Offline"
    : connection.socket === "connected"
      ? "Online · Server connected"
      : connection.socket === "reconnecting"
        ? "Online · Reconnecting…"
        : "Online · Server disconnected";
}
window.addEventListener("online", updateConnectionStatus);
window.addEventListener("offline", updateConnectionStatus);
socket?.on("connect", updateConnectionStatus);
socket?.on("disconnect", updateConnectionStatus);
socket?.on("connect_error", updateConnectionStatus);
updateConnectionStatus();

// ========================================
// 9. INITIALIZATION
// ========================================

async function requestDashboardLocation() {
  const locationReady = await initializeDashboardMap();
  if (!locationReady) return;
  await startLocationTracking();
  await loadNearbyHelpers();
  await loadNearbyAlerts();
}

function initializeDashboard() {
  loadSearchingEmergencies();
  requestDashboardLocation();
}

// Initialize when page loads, with the same location request available for retry.
if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initializeDashboard, { once: true });
} else {
  initializeDashboard();
}

console.log("[Dashboard] Loaded");
</script>

</body>
</html>
